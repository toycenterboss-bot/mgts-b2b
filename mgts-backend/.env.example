# Развернуть с нуля:
#   cp .env.example .env
#   node -e "for(const k of ['APP_KEYS','API_TOKEN_SALT','ADMIN_JWT_SECRET','TRANSFER_TOKEN_SALT','JWT_SECRET','ENCRYPTION_KEY'])console.log(k+'='+require('crypto').randomBytes(16).toString('base64'))"
#   npm install && npm run develop
#   node scripts/check-fresh-schema.mjs   — сверить схему с рабочей
#
# ⚠️ Схема соберётся из файлов типов контента и совпадёт с рабочей (158 таблиц).
#    Контента при этом НЕ БУДЕТ: страниц 0. Наполнение — отдельный вопрос (B-34).

HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Токен для служебных скриптов (Strapi → Settings → API Tokens → Full access)
STRAPI_API_TOKEN=
# Ключ LLM для скриптов анализа контента
PERPLEXITY_API_KEY=
